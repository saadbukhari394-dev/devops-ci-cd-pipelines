FROM jenkins/jenkins:lts-jdk17

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl docker.io python3 python3-venv unzip \
    && curl -fsSLo /tmp/sonar-scanner.zip https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-6.2.1.4610-linux-x64.zip \
    && unzip /tmp/sonar-scanner.zip -d /opt \
    && ln -s /opt/sonar-scanner-6.2.1.4610-linux-x64 /opt/sonar-scanner \
    && rm /tmp/sonar-scanner.zip \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/sonar-scanner/bin:${PATH}"
USER jenkins